# Network Endpoints
VARA_WS_ENDPOINT=wss://testnet.vara.network
NEXT_PUBLIC_VARA_WS=wss://testnet.vara.network
# BluToken Deployed Program ID (generated via `pnpm contracts:deploy`)
NEXT_PUBLIC_PROGRAM_ID=0xd43593c715fdd31c6d514527da2d9d6b3e8f57b5d155fb3e5fb286dce6755a1c
NEXT_PUBLIC_EXPLORER_URL=https://idea.gear-tech.io/programs
NEXT_PUBLIC_API_BASE=/api

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blutoken?schema=public

# Indexer
START_BLOCK=0

# IPFS Pinning & Gateways
IPFS_PINNING_JWT=
IPFS_GATEWAYS=https://ipfs.io/ipfs/,https://cloudflare-ipfs.com/ipfs/

# Authentication & Security
SESSION_SECRET=dev_session_secret_change_in_production_min_32_chars

# MRV Worker
MRV_WORKER_URL=http://localhost:8000
MRV_SHARED_SECRET=dev_mrv_shared_secret
EE_SERVICE_ACCOUNT_JSON_PATH=
