{
  "name": "blutoken-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Blockchain-based Blue Carbon Registry and MRV Platform for India",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "contracts:build": "cargo build --manifest-path contracts/Cargo.toml --release",
    "contracts:test": "cargo test --manifest-path contracts/Cargo.toml",
    "contracts:clippy": "cargo clippy --manifest-path contracts/Cargo.toml -- -D warnings",
    "contracts:fmt": "cargo fmt --manifest-path contracts/Cargo.toml --check",
    "contracts:deploy": "pnpm --filter @blutoken/contracts run deploy:program",
    "contracts:smoke": "pnpm --filter @blutoken/contracts run smoke",
    "indexer:rebuild": "pnpm --filter @blutoken/indexer run rebuild"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "@polkadot/keyring": "14.0.3",
    "@polkadot/types": "14.3.1",
    "@polkadot/types-codec": "14.3.1",
    "@polkadot/types-create": "14.3.1",
    "@polkadot/api": "14.3.1"
  },
  "packageManager": "pnpm@9.15.4"
}
